<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.sohan.smartussd.ui.PulseLoaderView
        android:id="@+id/pulseLoader"
        android:layout_width="104dp"
        android:layout_height="104dp" />

    <!-- Variant 2: a menu choice / reply is being sent -->
    <LinearLayout
        android:id="@+id/choiceGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <View
                android:id="@+id/choiceHalo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/choiceBadge"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_menu_number"
                android:gravity="center"
                android:textColor="@color/on_accent"
                android:textSize="34sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="6dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_skeleton">

            <View
                android:id="@+id/choiceSweep"
                android:layout_width="60dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_button_primary" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/loadingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Contacting network"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/loadingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="This usually takes a few seconds"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/skeletonBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="20dp"
        android:paddingEnd="56dp">

        <View
            android:id="@+id/skeleton1"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:id="@+id/skeleton2"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="56dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:id="@+id/skeleton3"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="120dp"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>

    <!-- Smooth progress + rotating tip: gives the wait something to look at -->
    <FrameLayout
        android:id="@+id/progressTrack"
        android:layout_width="180dp"
        android:layout_height="4dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/bg_skeleton">

        <View
            android:id="@+id/progressFill"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/bg_button_primary" />
    </FrameLayout>

    <!-- Live checklist: shows what is happening right now -->
    <LinearLayout
        android:id="@+id/stepsBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/step2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/step3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_stat_panel"
        android:gravity="center"
        android:maxWidth="300dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:minLines="2"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/loadingCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:paddingStart="30dp"
        android:paddingTop="13dp"
        android:paddingEnd="30dp"
        android:paddingBottom="13dp"
        android:text="Cancel"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</merge>
