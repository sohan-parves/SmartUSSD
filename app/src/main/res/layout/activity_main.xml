<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

<ScrollView
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <include layout="@layout/include_header" />

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USSD Dialer"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp"
            android:text="Manage your mobile services easily."
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- SIM SELECTOR CARD -->
        <LinearLayout
            android:id="@+id/cardSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionLabel"
                android:text="SELECT SIM CARD" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner">

                <Spinner
                    android:id="@+id/simSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingStart="10dp"
                    android:paddingEnd="40dp"
                    android:popupBackground="@drawable/bg_spinner_popup" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </FrameLayout>
        </LinearLayout>

        <!-- USSD INPUT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionLabel"
                android:text="ENTER USSD CODE" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/ussdInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:digits="0123456789*#"
                    android:gravity="center"
                    android:hint="*121#"
                    android:inputType="phone"
                    android:letterSpacing="0.12"
                    android:maxLength="40"
                    android:paddingStart="52dp"
                    android:paddingEnd="52dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_faint"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnBackspace"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:padding="12dp"
                    android:src="@drawable/ic_backspace" />
            </FrameLayout>

            <com.sohan.smartussd.ui.DialPadView
                android:id="@+id/dialPad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnSend"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="SEND USSD  →" />
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="25dp"
            android:text="Smart USSD"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>

    <include layout="@layout/include_result" />

    <!-- Launch splash: logo, then fades out -->
    <LinearLayout
        android:id="@+id/splashLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="Smart USSD"
            android:padding="8dp"
            android:src="@drawable/ic_logo_glyph" />

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Smart USSD"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your SIM, Your Control"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
